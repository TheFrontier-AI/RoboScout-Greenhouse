# Copy to .env on the VM (never commit .env). Uncomment the <...> lines and fill them in (keep <...> lines commented
# while unset: the file is also `source`d by scripts).
# NEBIUS_API_KEY=<token factory api key>
BRAIN_BASE_URL=https://api.tokenfactory.nebius.com/v1/
BRAIN_MODEL=nvidia/nemotron-3-super-120b-a12b
# Cosmos-Reason2-8B is gated: accept its licence on Hugging Face, then put a read token here
# HF_TOKEN=<hugging face read token>
COSMOS_MODEL=nvidia/Cosmos-Reason2-8B
EYES_MODEL=nvidia/Cosmos-Reason2-8B
EYES_API_KEY=local-not-needed
# Eyes without a GPU (verified on Token Factory 2026-10-28): NVIDIA's hosted vision model
# EYES_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# EYES_MODEL=nvidia/Nemotron-3.5-Super-VL      (EYES_API_KEY = your NEBIUS_API_KEY)
ROBOT_API_URL=http://127.0.0.1:8090
# Analysis pipeline (cloud/pipeline, started by deploy/nebius/start_pipeline.sh)
DETECTOR_MODEL=vision_runs/rtdetr_v2_mixed/best      # fine-tuned RT-DETRv2 dir (config.json + model.safetensors); ask the author
DETECTOR_THRESHOLD=0.5
EYES2_BASE_URL=https://api.tokenfactory.nebius.com/v1/
EYES2_MODEL=nvidia/Nemotron-3.5-Super-VL              # per-plant-stop VLM, six views per request (EYES2_API_KEY = NEBIUS_API_KEY)
PIPELINE_AUTO=0                                        # 0: the watcher runs the pipeline; 1: the hub also spawns it on /run_complete
PIPELINE_VLM_WORKERS=4
# optional GPU steps; the pipeline skips them when these are missing
# CUVSLAM_PYTHON=/home/ubuntu/cuvslam_venv/bin/python
# LINGBOT_RUN=/home/ubuntu/RoboScout-Greenhouse/deploy/nebius/lingbot/run.sh
# LINGBOT_IMAGE=lingbot:blackwell
# Object Storage (S3-compatible) for videos and SLAM outputs
# AWS_ACCESS_KEY_ID=<nebius object storage key id>
# AWS_SECRET_ACCESS_KEY=<nebius object storage secret>
# S3_ENDPOINT=<nebius object storage endpoint>
S3_BUCKET=r1-hackathon
