# Copy to .env on the VM (never commit .env). Values marked <...> come from the Nebius console.
NEBIUS_API_KEY=<token factory api key>
BRAIN_BASE_URL=https://api.tokenfactory.nebius.com/v1/
BRAIN_MODEL=nvidia/nemotron-3-super-120b-a12b
# Cosmos-Reason2-8B is gated: accept its licence on Hugging Face, then put a read token here
HF_TOKEN=<hugging face read token>
COSMOS_MODEL=nvidia/Cosmos-Reason2-8B
EYES_MODEL=nvidia/Cosmos-Reason2-8B
EYES_API_KEY=local-not-needed
ROBOT_API_URL=http://127.0.0.1:8090
# Object Storage (S3-compatible) for videos and SLAM outputs
AWS_ACCESS_KEY_ID=<nebius object storage key id>
AWS_SECRET_ACCESS_KEY=<nebius object storage secret>
S3_ENDPOINT=<nebius object storage endpoint>
S3_BUCKET=r1-hackathon
