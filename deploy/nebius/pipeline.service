# R1 robot hub + post-survey analysis pipeline (deploy/nebius/start_pipeline.sh) as a systemd service.
# Template: deploy/nebius/install_cloud.sh --service fills __USER__/__HOME__/__REPO__/__PY__/__RUNS__ and installs it.
#   journalctl -u pipeline -f        tail -f ~/runs/logs/{hub,pipeline}.log
[Unit]
Description=R1 robot hub + analysis pipeline watcher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=RUNS_DIR=__RUNS__
Environment=PY=__PY__
Environment=HUB_PORT=8090
Environment=PIPELINE_AUTO=0
ExecStart=/bin/bash __REPO__/deploy/nebius/start_pipeline.sh
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
