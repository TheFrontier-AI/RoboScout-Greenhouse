{
    def Cube "removable_front_obstacle" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.65, 0.18, 0.7)
        double3 xformOp:translate = (0, -100, -10)
